<Window x:Class="WpfApp1.SuperRepair.SuperSizeMismatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super 容量不一致"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设备 Super 容量与云端定义不一致"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#FF263142" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14"
                Background="#FFFAFBFD"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="已选机型" Foreground="#FF64748B" Margin="0,0,0,9" />
                <TextBlock x:Name="DeviceText"
                           Grid.Column="1"
                           Foreground="#FF334155"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,9" />

                <TextBlock Grid.Row="1" Text="设备报告" Foreground="#FF64748B" Margin="0,0,0,9" />
                <TextBlock x:Name="DeviceSizeText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Foreground="#FF334155"
                           FontFamily="Cascadia Mono,Consolas"
                           Margin="0,0,0,9" />

                <TextBlock Grid.Row="2" Text="云端定义" Foreground="#FF64748B" />
                <TextBlock x:Name="DefinitionSizeText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Foreground="#FF334155"
                           FontFamily="Cascadia Mono,Consolas" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,15,0,0"
                   Text="Fastboot 在部分动态 Super 设备上可能返回非实际物理容量。如果确认选择的机型没有问题，可以继续刷入；选择错误的机型可能导致 Super metadata 不匹配。"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="#FFB45309" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}"
                    Background="White"
                    BorderBrush="#FFD8DEE8"
                    Foreground="#FF475569" />
            <Button Content="机型无误，继续刷入"
                    Margin="10,0,0,0"
                    Click="ContinueButton_Click"
                    Style="{StaticResource DialogButtonStyle}"
                    Background="#FF8B5CF6"
                    BorderBrush="#FF8B5CF6"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
