<Window x:Class="WpfApp1.SuperRepair.RepairSuperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修复 Super 真死"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FC"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="RepairSuperCardGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE2E6ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,10,12,8"
                                        BorderBrush="#FFF0F2F6"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextElement.Foreground="#FF263142"
                                                      TextElement.FontWeight="SemiBold" />
                                </Border>
                                <ContentPresenter Grid.Row="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepairSuperComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem"
                           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Foreground" Value="#FF334155" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepairSuperPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#FF8B5CF6" />
            <Setter Property="BorderBrush" Value="#FF8B5CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="选择机型"
                      Style="{StaticResource RepairSuperCardGroupBoxStyle}"
                      HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="品牌" VerticalAlignment="Center" Foreground="#FF64748B" />
                    <ComboBox x:Name="BrandComboBox"
                              Grid.Column="1"
                              Style="{StaticResource RepairSuperComboBoxStyle}"
                              SelectionChanged="BrandComboBox_SelectionChanged" />

                    <TextBlock Grid.Row="2" Text="系列" VerticalAlignment="Center" Foreground="#FF64748B" />
                    <ComboBox x:Name="SeriesComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Style="{StaticResource RepairSuperComboBoxStyle}"
                              SelectionChanged="SeriesComboBox_SelectionChanged" />

                    <TextBlock Grid.Row="4" Text="机型" VerticalAlignment="Center" Foreground="#FF64748B" />
                    <ComboBox x:Name="DeviceComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Style="{StaticResource RepairSuperComboBoxStyle}"
                              SelectionChanged="DeviceComboBox_SelectionChanged" />

                    <Border Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            Padding="10,8"
                            Background="#FFFFFBEB"
                            BorderBrush="#FFFDE7B0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="本功能仅适用于可正常进入 FastbootD 模式的设备；无法进入 FastbootD 模式时，请先修复后再使用本功能。"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   FontSize="11"
                                   Foreground="#FFB45309" />
                    </Border>
                </Grid>
            </GroupBox>

            <Button x:Name="RepairButton"
                    Grid.Row="2"
                    Content="开始修复"
                    Click="RepairButton_Click"
                    Style="{StaticResource RepairSuperPrimaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFE7E9EF"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Margin="18,0"
                       Text="正在加载云端机型..."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#FF64748B" />
        </Border>

        <Border x:Name="BusyOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="#220F172A">
            <Border Width="310"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#FFE2E6ED"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="BusyText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FF475569"
                           Text="正在处理..." />
            </Border>
        </Border>
    </Grid>
</Window>
