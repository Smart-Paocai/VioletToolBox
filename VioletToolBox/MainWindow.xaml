                                                        VerticalScrollBarVisibility="Auto"
                                                        FontSize="12"
                                                        Padding="10"
                                                        BorderThickness="1"
                                                        BorderBrush="#FFDCE3EC"
                                                        Foreground="#FF1E293B"
                                                        Background="#FFFBFCFE"
                                                        Margin="0"
                                                        Text="投屏实时输出..."
                                                        IsReadOnly="True"
                                                        TextChanged="ScreenMirrorLogTextBox_TextChanged">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Text" Value="投屏日志将在这里显示..."/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsFocused" Value="True">
                                                                        <Setter Property="Text" Value=""/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid
				Name="BasicFlashView"
				Visibility="Collapsed"
                            Background="#FFF8FAFD">
