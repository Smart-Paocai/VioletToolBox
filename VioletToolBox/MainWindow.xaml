                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FlashBatTextBox"
