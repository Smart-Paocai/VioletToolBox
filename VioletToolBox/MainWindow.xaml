                                    <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#FFCFD8E3"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="8,0"/>
