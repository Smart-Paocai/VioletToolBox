                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFE2E6ED"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#FF263142"/>
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10"/>
                                </Style>

                                <Style x:Key="FastbootSecondaryButtonStyle"
                                       TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FastbootButtonBaseStyle}">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="BorderBrush" Value="#FFD8DEE8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>

