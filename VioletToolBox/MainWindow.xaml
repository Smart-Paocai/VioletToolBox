                                <Style x:Key="ColorOSProgressBarStyle" TargetType="{x:Type ProgressBar}">
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <Grid ClipToBounds="True">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="4">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource ProgressBarIndicatorWidthConverter}">
                                                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="#FF87CEEB"/>
                                                                    <GradientStop Offset="1" Color="#FF4A90E2"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="12"
                                                                   Foreground="#FF333333"
                                                                   FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}%}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   FontSize="12"
                                                                   Foreground="#FF333333"
                                                                   FontWeight="Medium"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid MaxWidth="980" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="6,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="2" Style="{StaticResource ColorOSCardStyle}" Margin="0">
                                        <StackPanel>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource ColorOSFieldLabelStyle}">
                                                    <Run Text="降级包保存目录"/>
                                                    <Run FontWeight="Normal"
                                                         Foreground="#FF94A3B8"
                                                         Text="（默认当前用户桌面）"/>
                                                </TextBlock>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtDownloadDir"
                                                             Grid.Column="0"
                                                             Style="{StaticResource ColorOSPathTextBoxStyle}"
                                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <Button x:Name="BtnBrowseDir"
                                                            Grid.Column="2"
                                                            Style="{StaticResource FastbootPrimaryButtonStyle}"
                                                            Width="84"
                                                            Click="BtnBrowseDir_Click"
                                                            BorderBrush="#FFE6E6E6"
                                                            Background="SkyBlue"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                                            <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource ColorOSFieldLabelStyle}">
                                                    <Run Text="本地降级包"/>
                                                    <Run FontWeight="Normal"
                                                         Foreground="#FF94A3B8"
                                                         Text="（可选）"/>
                                                </TextBlock>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtPushFile"
                                                             Grid.Column="0"
                                                             Style="{StaticResource ColorOSPathTextBoxStyle}"
                                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <Button x:Name="BtnBrowseFile"
                                                            Grid.Column="2"
                                                            Style="{StaticResource FastbootPrimaryButtonStyle}"
                                                            Width="84"
                                                            Click="BtnBrowseFile_Click"
                                                            BorderBrush="#FFE6E6E6"
                                                            Background="SkyBlue"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                                            <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource ColorOSFieldLabelStyle}">
                                                    <Run Text="降级助手 APK"/>
                                                    <Run FontWeight="Normal"
                                                         Foreground="#FF94A3B8"
                                                         Text="（可选，查询前自动安装）"/>
                                                </TextBlock>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtAssistantApk"
                                                             Grid.Column="0"
                                                             Style="{StaticResource ColorOSPathTextBoxStyle}"
                                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <Button x:Name="BtnBrowseAssistantApk"
                                                            Grid.Column="2"
                                                            Click="BtnBrowseAssistantApk_Click"
                                                            Style="{StaticResource FastbootPrimaryButtonStyle}"
                                                            Width="84"
                                                            BorderBrush="#FFE6E6E6"
                                                            Background="SkyBlue"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <svg:SvgViewbox Source="images/文件夹.svg"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Margin="0,0,5,0"/>
                                                            <TextBlock Text="选择"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="White"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="0" Style="{StaticResource ColorOSCardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ColorOSTitleStyle}" Text="操作"/>
                                            <TextBlock Style="{StaticResource ColorOSSubtitleStyle}"
                                                       Margin="0,4,0,0"
                                                       ><Run Text="若查询不到降级包，请将设备连接网络后，手动"/><Run Language="zh-cn" Text="在"/><Run Text="设备上检查一遍更新后再重新尝试查询."/></TextBlock>
                                            <Button x:Name="BtnDownloadApk"
                                                    Margin="0,12,0,0"
                                                    Width="248"
                                                    Height="36"
                                                    HorizontalAlignment="Center"
                                                    Click="BtnDownloadApk_Click"
                                                    ToolTip="必须下载安装到需降级的设备"
                                                    Style="{StaticResource ColorOSTertiaryButtonStyle}"
                                                    Content="【第一步】下载降级助手 APK"/>
                                            <Button x:Name="BtnQueryOnly"
                                                    Margin="0,8,0,0"
                                                    Width="248"
                                                    Height="36"
                                                    HorizontalAlignment="Center"
                                                    Click="BtnQueryOnly_Click"
                                                    Style="{StaticResource ColorOSSecondaryButtonStyle}"
                                                    Content="【第二步】查询降级包"/>
                                            <Button x:Name="StartBtn"
                                                    Margin="0,8,0,0"
                                                    Width="248"
                                                    Height="36"
                                                    HorizontalAlignment="Center"
                                                    Click="StartBtn_Click"
                                                    Style="{StaticResource ColorOSPrimaryButtonStyle}"
                                                    Content="【第三步】下载并推送"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" Margin="6,0,6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.35*"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource ColorOSCardStyle}" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource ColorOSTitleStyle}" Text="可用降级版本"/>
                                            <TextBlock Grid.Row="2"
                                                       Style="{StaticResource ColorOSSubtitleStyle}"
                                                       Text="单击任意一行选择版本并解析云端信息，右侧可复制原始下载链接。"/>
                                            <DataGrid x:Name="PackagesGrid"
                                                      Grid.Row="4"
                                                      Margin="0"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      SelectionChanged="PackagesGrid_SelectionChanged"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      ColumnHeaderStyle="{StaticResource ColorOSColumnHeaderStyle}"
                                                      AlternatingRowBackground="#FFFAFBFD"
                                                      Background="#FFFFFFFF"
                                                      BorderThickness="1"
                                                      BorderBrush="#FFE2E6ED"
                                                      RowHeight="32"
                                                      ColumnHeaderHeight="32">
                                                <DataGrid.Resources>
                                                    <Style TargetType="{x:Type DataGridRow}"
                                                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Setter Property="Foreground" Value="#FF334155"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFF0F8FC"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#FF87CEEB"/>
                                                                <Setter Property="Foreground" Value="#FF1E293B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="{x:Type DataGridCell}"
                                                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#FF87CEEB"/>
                                                                <Setter Property="Foreground" Value="#FF1E293B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="选择" Width="52">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Style="{StaticResource ColorOSPackageCheckBoxStyle}"
                                                                          PreviewMouseLeftButtonDown="ColorOSPackageCheckBox_PreviewMouseLeftButtonDown"
                                                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="ColorOS 版本"
                                                                        Binding="{Binding ColorOSVersion}"
                                                                        HeaderStyle="{StaticResource ColorOSLeftColumnHeaderStyle}"
                                                                        ElementStyle="{StaticResource ColorOSLeftDataTextStyle}"
                                                                        Width="135"/>
                                                    <DataGridTextColumn Header="安卓版本"
                                                                        Binding="{Binding AndroidVersionDisplay}"
                                                                        ElementStyle="{StaticResource ColorOSCenteredDataTextStyle}"
                                                                        Width="74"/>
                                                    <DataGridTextColumn Header="文件大小"
                                                                        Binding="{Binding SizeGB, StringFormat={}{0:F2} GB}"
                                                                        ElementStyle="{StaticResource ColorOSCenteredDataTextStyle}"
                                                                        Width="90"/>
                                                    <DataGridTemplateColumn Header="OTA 版本名"
                                                                            HeaderStyle="{StaticResource ColorOSLeftColumnHeaderStyle}"
                                                                            Width="*"
                                                                            MinWidth="220">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding OtaVersion}"
                                                                           ToolTip="{Binding OtaVersion}"
                                                                           Style="{StaticResource ColorOSLeftDataTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="操作" Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="复制链接"
                                                                        Style="{StaticResource ColorOSGridActionButtonStyle}"
                                                                        ToolTip="{Binding DownloadUrl}"
                                                                        Click="CopyColorOSDownloadLink_Click"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <GroupBox Grid.Row="2"
                                              Header="执行日志"
                                              Style="{StaticResource ColorOSLogGroupBoxStyle}"
                                              Margin="0">
                                        <Grid Background="#FFFAFBFD">
                                            <RichTextBox x:Name="LogBox"
                                                         IsReadOnly="True"
                                                         Background="#FFFAFBFD"
                                                         BorderThickness="0"
                                                         Padding="7,7"
                                                         HorizontalContentAlignment="Stretch"
                                                         VerticalContentAlignment="Stretch"
                                                         FontFamily="Cascadia Mono,Microsoft YaHei UI,Consolas"
                                                         FontSize="11.75"
                                                         FontWeight="Normal"
                                                         Foreground="#FF334155"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         IsDocumentEnabled="False">
                                                <FlowDocument PagePadding="0"
                                                              ColumnWidth="10000"
                                                              ColumnGap="0"
                                                              TextAlignment="Left"
                                                              LineHeight="19">
                                                    <Paragraph Foreground="#FF64748B"
                                                           FontSize="11.75"
                                                           LineHeight="19"
                                                           Margin="0">
                                                        <Run FontWeight="SemiBold"
                                                         Foreground="#FFD97706"
                                                         Text="风险提示："/>
                                                        <LineBreak/>
                                                        <Run Text="本功能仅适用于已经熔断的 OPPO 和一加设备进行大安卓版本降级；未熔断设备使用可能导致不可逆熔断。"/>
                                                        <LineBreak/>
                                                        <Run Text="降级会清空数据，请提前备份重要数据。本界面下载的刷机包可用于官方 OTA 安装或 Fastboot 卡刷转线刷模式安装。"/>
                                                        <LineBreak/>
                                                        <Run Text="本功能适用于 OPPO 和一加设备，不适用于真我设备。特别鸣谢：酷安 @皓皓的小月。"/>
                                                    </Paragraph>
                                                </FlowDocument>
                                            </RichTextBox>
                                        </Grid>
                                    </GroupBox>
                                </Grid>

                                <ProgressBar x:Name="DownloadProgress"
                                             Grid.Row="4"
                                             Margin="6,0,6,1"
                                             Height="24"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Tag="等待开始"
                                             Background="#FFF0F0F0"
                                             BorderBrush="#FFD8D8D8"
                                             BorderThickness="1"
                                             Style="{StaticResource ColorOSProgressBarStyle}"/>
                                <TextBlock x:Name="TxtProgressInfo"
                                           Visibility="Collapsed"
                                           Text="准备就绪"/>
                            </Grid>
                        </Grid>

                        <!-- 备份助手视图 -->
                        <Grid Name="BackupAssistantView" Visibility="Collapsed" Margin="12,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <!-- 主内容区域 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部工具栏 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button x:Name="btnLoadImages" Content="🔄 加载图片" Width="100" Height="32" Click="BtnLoadImages_Click" IsEnabled="False"/>
                                    <TextBlock Text="并发数:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                    <ComboBox x:Name="cbThreadCount" Width="70" Height="32" SelectedIndex="4">
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="32"/>
                                        <ComboBoxItem Content="64"/>
                                        <ComboBoxItem Content="128"/>
                                        <ComboBoxItem Content="256"/>
                                    </ComboBox>
                                    <Button x:Name="btnToggleSelectAll" Content="✓ 全选" Width="90" Height="32" Margin="20,0,0,0" Click="BtnToggleSelectAll_Click" IsEnabled="False"/>
                                    <Button x:Name="btnBackup" Content="💾 备份选中图片" Width="130" Height="32" Margin="20,0,0,0" IsEnabled="False" Click="BtnBackup_Click"/>
                                    <Button x:Name="btnRestoreContacts" Content="📥 恢复通讯录" Width="110" Height="32" Margin="20,0,0,0" IsEnabled="False" Visibility="Collapsed" Click="BtnRestoreContacts_Click"/>
                                </StackPanel>

                                <!-- 相册网格视图 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="photoGallery" Orientation="Horizontal"/>
                                </ScrollViewer>

                                <!-- 底部状态栏 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                                    <TextBlock x:Name="lblStatus" Text="正在检测设备..." Width="400" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="progressBar" Width="350" Height="20" Margin="10,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 右侧导航栏 -->
                            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" Background="WhiteSmoke">
                                <StackPanel>
                                    <Button x:Name="btnNavPhotos" Content=" 📷&#x0a;图片" Width="78" Height="80" Click="BtnNavPhotos_Click" FontSize="14" Background="DodgerBlue" Foreground="White" BorderThickness="0"/>
                                    <Button x:Name="btnNavVideos" Content=" 🎬&#x0a;视频" Width="78" Height="80" Click="BtnNavVideos_Click" FontSize="14" Margin="0,1,0,0" Background="White" Foreground="Black" BorderThickness="0"/>
                                    <Button x:Name="btnNavContacts" Content="  📞&#x0a;通讯录" Width="78" Height="80" Click="BtnNavContacts_Click" FontSize="14" Margin="0,1,0,0" Background="White" Foreground="Black" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Name="AboutToolView" Visibility="Collapsed" Background="#FFF6F8FA">
                            <Grid.Resources>
                                <Style x:Key="AboutCardStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFD0D7DE"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="16"/>
                                </Style>
                                <Style x:Key="AboutSectionTitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF1F2328"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                                <Style x:Key="AboutBodyTextStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="#FF656D76"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="20"/>
                                </Style>
                                <Style x:Key="AboutTagBorderStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#FFF6F8FA"/>
                                    <Setter Property="BorderBrush" Value="#FFD0D7DE"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="9,4"/>
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                </Style>
                                <Style x:Key="AboutTagTextStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF1F2328"/>
                                </Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="#FFD0D7DE"/>
                                    <Setter Property="StrokeThickness" Value="1"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                </Style>
                                <Style x:Key="AboutSocialButtonStyle"
                                        TargetType="Button"
                                        BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Width" Value="36"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFD0D7DE"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="AboutSocialButtonBorder"
                                                         Background="{TemplateBinding Background}"
                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                         BorderThickness="{TemplateBinding BorderThickness}"
                                                         CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AboutSocialButtonBorder" Property="Background" Value="#FFF3F4F6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="AboutSocialButtonBorder" Property="Background" Value="#FFEAEEF2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="16,12,16,24">

                                    <!-- 作者区域 -->
                                    <TextBlock Text="项目作者" Style="{StaticResource AboutSectionTitleStyle}"/>
                                    <Border Style="{StaticResource AboutCardStyle}" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="64" Height="64" VerticalAlignment="Top">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="pack://application:,,,/paocai.jpg"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="泡菜" FontSize="18" FontWeight="SemiBold" Foreground="#FF1F2328"/>
                                                <Border Background="#FFDDF4FF" BorderBrush="#FF54AEFF" BorderThickness="1" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left" Margin="0,6,0,8">
                                                    <TextBlock Text="前后端开发 &amp; 核心架构" FontSize="12" Foreground="#FF0969DA" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="该项目由哔哩哔哩UP主”泡菜学不会“开发，开发此项目希望能为安卓玩机生态贡献自己的一份力量。"
                                                           Style="{StaticResource AboutBodyTextStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 赞助与社交媒体区域 -->
                                    <Border Style="{StaticResource AboutCardStyle}" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
