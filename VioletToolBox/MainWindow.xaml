                                                                        <svg:SvgViewbox
                                                                        Source="images/盾牌.svg"
                                                                        Width="16"
                                                                        Height="16"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="该分区已受基带指纹保护，当前禁止写入">
