                                                        <CheckBox x:Name="MirrorTitleShowDeviceNameCheckBox" Content="设备名称" IsChecked="True" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
