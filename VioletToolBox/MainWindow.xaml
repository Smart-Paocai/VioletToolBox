                                                Click="SelectFlashBatButton_Click"
                                                Style="{StaticResource FastbootPrimaryButtonStyle}"
                                                Width="84" BorderBrush="#FFE6E6E6" Background="skyblue">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                                <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </GroupBox>

                                <!-- Partition Table -->
                                <GroupBox Grid.Row="0"
                                          Header="分区表"
                                          Style="{StaticResource FastbootCardGroupBoxStyle}"
                                          Margin="0,0,0,8"
                                          Padding="10,12,10,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="28"
                                                Width="150"
                                                Margin="0,0,0,8"
                                                Padding="8,0"
                                                HorizontalAlignment="Left"
                                                Background="#FFFFFFFF"
                                                BorderBrush="#FFDDE2EA"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="&#xE721;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="#FF94A3B8"
                                                           VerticalAlignment="Center"/>
                                                <TextBox x:Name="PartitionSearchTextBox"
                                                         Grid.Column="1"
                                                         Padding="2,0,0,0"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="12"
                                                         Foreground="#FF334155"
                                                         ToolTip="搜索分区名称"
                                                         TextChanged="PartitionSearchTextBox_TextChanged"
                                                         KeyDown="PartitionSearchTextBox_KeyDown"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="4,0,0,0"
                                                           Text="请输入分区名称..."
                                                           FontSize="12"
                                                           Foreground="#FF94A3B8"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=PartitionSearchTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <CheckBox x:Name="GenerateRawProgramXmlCheckBox"
                                                  Grid.Row="0"
                                                  Content="生成XML"
                                                  IsChecked="True"
                                                  Margin="162,0,0,8"
                                                  FontSize="12"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ToolTip="回读完成后，生成 rawprogram*.xml文件"/>

                                        <CheckBox x:Name="ProtectPartitionCheckBox"
                                                  Grid.Row="0"
                                                  Content="保护分区"
                                                  IsChecked="True"
                                                  Margin="245,0,0,8"
                                                  FontSize="12"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Checked="ProtectPartitionCheckBox_Checked"
                                                  ToolTip="保护基带分区和数据分区不被写入"/>

                                        <TextBlock x:Name="PartitionSelectionSummaryTextBlock"
                                                   Grid.Row="0"
                                                   Width="151"
                                                   Margin="336,8,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   FontFamily="Microsoft YaHei UI"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="#FF64748B"
                                                   Text="已选 0/0 · 0 B"
                                                   Tag="已选择 0 / 0  |  总计 0 B"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}"/>

                                        <DataGrid x:Name="PartitionTableDataGrid"
                                                  Grid.Row="1"
                                                  AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  Foreground="#FF334155"
                                                  Background="#FFFFFFFF"
                                                  FontFamily="Microsoft YaHei UI"
                                                  FontSize="12"
                                                  IsSynchronizedWithCurrentItem="True"
                                                  RowHeight="29"
                                                  AlternationCount="2"
                                                  SelectionChanged="PartitionTableDataGrid_SelectionChanged"
                                                  MouseDoubleClick="PartitionTableDataGrid_MouseDoubleClick"
                                                  BorderBrush="#FFE7E9EF"
                                                  BorderThickness="1"
                                                  GridLinesVisibility="None"
                                                  HorizontalGridLinesBrush="Transparent"
                                                  VerticalGridLinesBrush="Transparent"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="SkyBlue"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF333333"/>
                                                <Style x:Key="FastbootPartitionTextCellStyle" TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="选择" Width="40">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <CheckBox x:Name="PartitionSelectAllCheckBox" Content="" Checked="PartitionSelectAllCheckBox_Checked" Unchecked="PartitionSelectAllCheckBox_Unchecked" HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.HeaderTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="18"
                                                                  Height="18"
                                                                  HorizontalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Click="PartitionSelectionCheckBox_Click"
                                                                          Width="16"
                                                                          Height="16"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Focusable="False">
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="{x:Type CheckBox}"
                                                                               BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                                                        <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </CheckBox.Style>
                                                                </CheckBox>
                                                                <svg:SvgViewbox Source="images/盾牌.svg"
                                                                                Width="16"
                                                                                Height="16"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="该分区已受保护，当前禁止写入">
                                                                    <svg:SvgViewbox.Style>
                                                                        <Style TargetType="{x:Type svg:SvgViewbox}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                                                        <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </svg:SvgViewbox.Style>
                                                                </svg:SvgViewbox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="名称"
                                                                    Binding="{Binding PartitionName}"
                                                                    ElementStyle="{StaticResource FastbootPartitionTextCellStyle}"
                                                                    IsReadOnly="True"
                                                                    Width="140" />
                                                <DataGridTextColumn Header="大小"
                                                                    Binding="{Binding PartitionSize}"
                                                                    ElementStyle="{StaticResource FastbootPartitionTextCellStyle}"
                                                                    IsReadOnly="True"
                                                                    Width="100" />
                                                <DataGridTemplateColumn Header="文件路径" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FilePath}"
                                                                       Margin="0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding FilePath}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FilePath}" Value="">
                                                                                <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                <Setter Property="Foreground" Value="#FF999999"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FilePath}" Value="{x:Null}">
                                                                                <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                <Setter Property="Foreground" Value="#FF999999"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="#FF475569"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                                                    <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="#FF475569"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Operations Console -->
                                <GroupBox Grid.Row="2"
                                          Header="操作"
                                          Style="{StaticResource FastbootCardGroupBoxStyle}"
                                          Padding="10,11,10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="RestartCheckBox"
                                                      Content="自动重启"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"/>
                                            <CheckBox x:Name="SwitchSlotACheckBox"
                                                      Content="切换A槽"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"
                                                      IsEnabled="False"
                                                      ToolTip="对小米线刷BAT，或Fastboot模式下选择的RawProgram生效"/>
                                            <CheckBox x:Name="KeepUserDataCheckBox"
                                                      Content="清除数据"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"
                                                      IsEnabled="False"
                                                      ToolTip="对小米线刷BAT，或Fastboot模式下选择的RawProgram生效"/>
                                            <CheckBox x:Name="LockBootloaderCheckBox"
                                                      Content="锁定BL"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"
                                                      IsEnabled="False"
                                                      ToolTip="仅对已选择的小米线刷 BAT 脚本生效"/>
                                            <CheckBox x:Name="SkipCrcCheckBox"
                                                      Content="跳过CRC"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"
                                                      IsChecked="True"
                                                      IsEnabled="False"
                                                      Checked="SkipCrcCheckBox_Changed"
                                                      Unchecked="SkipCrcCheckBox_Changed"
                                                      ToolTip="跳过 crclist 和 sparsecrclist 分区，仅对小米线刷 BAT 脚本生效"/>
                                            <CheckBox x:Name="DisableDmVerityCheckBox"
                                                      Content="禁用DM校验"
                                                      Style="{StaticResource FastbootOptionCheckBoxStyle}"
                                                      Margin="0"
                                                      IsEnabled="False"
                                                      ToolTip="刷写 vbmeta 时添加 --disable-verity 和 --disable-verification"/>
                                        </StackPanel>
                                        <Button x:Name="AdbReadPartitionTableButton"
                                                Grid.Row="2" Grid.Column="0"
                                                Content="读分区表[开机]"
                                                Style="{StaticResource FastbootSecondaryButtonStyle}"
                                                ToolTip="开机状态下读取（需ROOT）"
                                                Click="AdbReadPartitionTableButton_Click" Width="114"/>
                                        <Button x:Name="ReadPartitionTableButton"
                                                Grid.Row="2" Grid.Column="2"
                                                Content="读分区表[FB]"
                                                Style="{StaticResource FastbootSecondaryButtonStyle}"
                                                ToolTip="Fastboot模式下读取分区表"
                                                Click="ReadPartitionTableButton_Click" Width="114"/>
                                        <Button x:Name="WritePartitionButton"
                                                Grid.Row="2" Grid.Column="4"
                                                Content="写入分区"
                                                Style="{StaticResource FastbootSecondaryButtonStyle}"
                                                Click="WritePartitionButton_Click" Width="114"/>
                                        <Button x:Name="ErasePartitionButton"
                                                Grid.Row="2" Grid.Column="6"
                                                Content="擦除分区"
                                                Style="{StaticResource FastbootSecondaryButtonStyle}"
                                                ToolTip="擦除指定分区"
                                                Click="ErasePartitionButton_Click" Width="114"/>

                                        <Button x:Name="BackupBasebandButton"
                                                Grid.Row="4" Grid.Column="0"
                                                Content="备份字库"
                                                Style="{StaticResource FastbootAdbOnlyButtonStyle}"
                                                ToolTip="仅在开机模式下可用（需ROOT）"
                                                Click="BackupBasebandButton_Click" Width="114"/>
                                        <Button x:Name="ReadPartitionButton"
                                                Grid.Row="4" Grid.Column="2"
                                                Content="回读分区"
                                                Style="{StaticResource FastbootAdbOnlyButtonStyle}"
                                                ToolTip="仅在开机模式下可用（需ROOT）"
                                                Click="ReadPartitionButton_Click" Width="114"/>
                                        <Button x:Name="BackupGptButton"
                                                Grid.Row="4" Grid.Column="4"
                                                Content="备份GPT"
                                                Style="{StaticResource FastbootAdbOnlyButtonStyle}"
                                                ToolTip="仅在开机模式下可用（需ROOT）"
                                                Click="BackupGptButton_Click" Width="114"/>
                                        <Button x:Name="StopFastbootVisualizationOperationButton"
                                                Grid.Row="4" Grid.Column="6"
                                                Content="停止操作"
                                                Style="{StaticResource FastbootStopButtonStyle}"
                                                IsEnabled="False"
                                                ToolTip="停止当前页面正在执行的操作"
                                                Click="StopFastbootVisualizationOperationButton_Click" Width="114"/>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <!-- Right Column: Log & Options -->
                            <Grid Grid.Column="1" Grid.Row="0" Margin="6,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Log -->
                                <GroupBox Grid.Row="0"
                                          Header="执行日志"
                                          Style="{StaticResource FastbootCardGroupBoxStyle}"
                                          Padding="0,10,0,0"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" Margin="-5,0,0,0">
                                    <Grid Background="#FFFAFBFD">
                                        <RichTextBox x:Name="FastbootLogTextBox" IsReadOnly="True" Background="#FFFAFBFD" BorderThickness="0" Padding="7,7" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FontFamily="Cascadia Mono,Microsoft YaHei UI,Consolas" FontSize="11.75" FontWeight="Normal" Foreground="#FF334155" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextChanged="FastbootLogTextBox_TextChanged_3" Margin="0,-5,0,0">
                                            <FlowDocument PagePadding="0" ColumnWidth="10000" ColumnGap="0" TextAlignment="Left" LineHeight="19"/>
                                        </RichTextBox>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar x:Name="OperationProgressBar"
                                         Grid.Row="1"
                                         Grid.ColumnSpan="2"
                                         Height="24"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Tag="0MB/s  |  Time:0s"
                                         Background="#FFF1F3F7"
                                         BorderBrush="#FFDCE1E8"
                                         BorderThickness="1"
                                         Margin="0,8,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="{x:Type ProgressBar}">
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <Grid ClipToBounds="True">
                                                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Offset="0" Color="#FF87CEEB" />
                                                                        <GradientStop Offset="1" Color="#FF4A90E2" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"
                                                                           FontSize="12"
                                                                           Foreground="#FF333333"
                                                                           FontWeight="Medium"/>
                                                            <TextBlock x:Name="ProgressText" 
                                                                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}" 
                                                                           HorizontalAlignment="Right" 
                                                                           VerticalAlignment="Center" 
                                                                           Margin="0,0,8,0"
                                                                           FontSize="12" 
                                                                           Foreground="#FF333333" 
                                                                           FontWeight="Medium"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                        <Grid
                            Name="HiddenEnvironmentView"
                            Visibility="Collapsed"
                            Background="#FFF7F8FC"
                            Cursor="">
                            <Grid.Resources>
                                <Style x:Key="FastbootSecondaryButtonStyle"
                                       TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FastbootButtonBaseStyle}">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="BorderBrush" Value="#FFD8DEE8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                                <Style x:Key="FastbootCardGroupBoxStyle"
                                       TargetType="{x:Type GroupBox}"
                                       BasedOn="{StaticResource PayloadGroupBoxStyle}">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFE2E6ED"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#FF263142"/>
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10"/>
                                </Style>
                                <Style x:Key="HiddenEnvironmentCheckBoxStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#FF475569"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                                <Style x:Key="HiddenEnvironmentSchemeCheckBoxStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource HiddenEnvironmentCheckBoxStyle}">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Grid.Resources>
                            <GroupBox Header=""
                                      Style="{StaticResource FastbootCardGroupBoxStyle}"
                                      Padding="0,10,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Width="361"
                                      Height="718"
                                      Margin="485,0,0,0">
                                <RichTextBox x:Name="HiddenEnvironmentLogTextBox"
                                             IsReadOnly="True"
                                             Background="#FFFAFBFD"
                                             BorderThickness="0"
                                             Padding="7,7"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch"
                                             FontFamily="Cascadia Mono,Microsoft YaHei UI,Consolas"
                                             FontSize="11.75"
                                             FontWeight="Normal"
                                             Foreground="#FF334155"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             IsDocumentEnabled="False"
                                             Margin="0,0,8,6">
                                    <FlowDocument PagePadding="0"
                                                  ColumnWidth="10000"
                                                  ColumnGap="0"
                                                  TextAlignment="Left"
                                                  LineHeight="19"/>
                                </RichTextBox>
                            </GroupBox>
                            <GroupBox Header="隐藏ROOT"
                                      Style="{StaticResource FastbootCardGroupBoxStyle}"
                                      Margin="0,0,368,465">
                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="资料目录：" VerticalAlignment="Top" FontSize="12" Margin="0,7,0,0"/>
                            </GroupBox>
                            <TextBox x:Name="HiddenRootZipPathTextBox" HorizontalAlignment="Left" Margin="76,12,0,0" TextWrapping="NoWrap" Text="请选择隐藏环境资源包7z文件" VerticalAlignment="Top" VerticalContentAlignment="Center" Padding="9,0" Width="292" Height="32" FontFamily="Microsoft YaHei UI" FontSize="12" Background="White" BorderBrush="#FFDDE2EA" BorderThickness="1" Foreground="#FF64748B" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button x:Name="SelectHiddenRootZipButton" HorizontalAlignment="Left" Margin="375,13,0,0" VerticalAlignment="Top" Width="84" Click="SelectHiddenRootZipButton_Click" Style="{StaticResource FastbootPrimaryButtonStyle}" BorderBrush="#FFE6E6E6" Background="SkyBlue">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <svg:SvgViewbox Source="images/文件夹.svg" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="选择" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
