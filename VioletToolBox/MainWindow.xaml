                                                        DisplayMemberPath="PartitionName"
                                                        SelectionChanged="EdlPartitionSearchComboBox_SelectionChanged"
                                                        DropDownOpened="EdlPartitionSearchComboBox_DropDownOpened"
                                                        PreviewTextInput="EdlPartitionSearchComboBox_PreviewTextInput"
                                                        KeyUp="EdlPartitionSearchComboBox_KeyUp"/>
                                                    </DockPanel>
                                                </Border>

                                                <DataGrid
                                            x:Name="EdlPartitionDataGrid"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="False"
                                            HeadersVisibility="Column"
                                            SelectionMode="Extended"
                                            SelectionUnit="FullRow"
                                            AlternationCount="2"
                                            FontSize="12"
                                            FontFamily="Microsoft YaHei UI"
                                            Foreground="#FF334155"
                                            Background="#FFFFFFFF"
                                            BorderBrush="#FFE7E9EF"
                                            BorderThickness="1"
                                            GridLinesVisibility="None"
                                            RowHeight="29"
                                            ColumnHeaderHeight="32"
                                            Grid.Row="1"
                                            Margin="0"
                                              MouseDoubleClick="EdlPartitionDataGrid_MouseDoubleClick">
                                                    <DataGrid.Resources>
                                                        <Style x:Key="EdlPartitionTextStyle" TargetType="{x:Type TextBlock}">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                        <Style x:Key="EdlPartitionCellStyle" TargetType="{x:Type DataGridCell}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground"
