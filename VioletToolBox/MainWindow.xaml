                                    <Setter Property="Background" Value="#FFE25562"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFE25562"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>

