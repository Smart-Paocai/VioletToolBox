                                                                    Property="Background"
                                                                    Value="#24B876DD" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="LanguageButtonBorder"
                                                                    Property="Background"
                                                                    Value="#3DB876DD" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="LanguageSwitchLabel"
                                               Text="EN"
                                               Margin="4,0,0,0"
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 设备类型显示文本 -->
                        <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="466,0,0,0">
                            <Ellipse
                            Name="BottomConnectionStatusIndicator"
                            Width="8"
                            Height="8"
                            Margin="0,0,6,0"
                            Fill="#7DFF9F"
                            Stroke="#E8FFF0"
                            StrokeThickness="0.8"
                            Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.65"
                                    Color="#63FF8C" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock
                            Name="BottomConnectionTypeText"
                            Text="--"
                            FontSize="12"
                            Foreground="#666666"
                            VerticalAlignment="Center"
                            Cursor="" />
                        </StackPanel>

                        <!-- 右下角的设备管理器按钮 -->
                        <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                            <!-- 服务器公告：有有效内容时显示，超长文案由代码自动横向播放 -->
                            <Border x:Name="BroadcastNoticeHost"
                                    Width="300"
                                    Height="22"
                                    Margin="0,0,12,0"
                                    Padding="8,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ClipToBounds="True"
                                    Cursor="Arrow"
                                    Visibility="Collapsed"
                                    MouseLeftButtonUp="BroadcastNoticeHost_MouseLeftButtonUp"
                                    SizeChanged="BroadcastNoticeHost_SizeChanged">
                                <Grid ClipToBounds="True">
                                    <TextBlock x:Name="BroadcastNoticeTextBlock"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#FF6D5C79"
                                               CacheMode="BitmapCache"
                                               TextOptions.TextFormattingMode="Display"
                                               TextWrapping="NoWrap">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- CMD按钮 -->
                            <Button
                            Name="CmdButton"
                            Content="CMD命令行"
                            Background="#00FFFFFF"
                            BorderThickness="0"
                            Foreground="#666666"
                            FontSize="12"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Click="CmdButton_Click">
                                <FrameworkElement.Style>
                                    <Style
                                    TargetType="{x:Type Button}">
                                        <Setter
                                        Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate
                                                TargetType="{x:Type Button}">
                                                    <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                        <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger
                                                        Property="UIElement.IsMouseOver"
                                                        Value="True">
                                                            <Setter
                                                            Property="Foreground"
                                                            Value="#333333" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </FrameworkElement.Style>
                            </Button>

                            <!-- 设备管理器按钮 -->
                            <Button
                            Name="DeviceManagerButton"
                            Content="设备管理器"
                            Background="#00FFFFFF"
                            BorderThickness="0"
                            Foreground="#666666"
                            FontSize="12"
                            Cursor="Hand"
                            Click="DeviceManagerButton_Click">
                                <FrameworkElement.Style>
                                    <Style
                                    TargetType="{x:Type Button}">
                                        <Setter
                                        Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate
                                                TargetType="{x:Type Button}">
                                                    <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                        <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger
                                                        Property="UIElement.IsMouseOver"
                                                        Value="True">
                                                            <Setter
                                                            Property="Foreground"
                                                            Value="#333333" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </FrameworkElement.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>




                <!-- 启动时的初始化遮罩层 -->
                <Grid x:Name="LoadingOverlay" Panel.ZIndex="999" Visibility="Collapsed" Grid.RowSpan="2" Grid.ColumnSpan="2">
                    <Grid.Background>
                        <SolidColorBrush Color="#E5FFFFFF" />
                    </Grid.Background>
                    <!-- 模糊效果，让背后的UI看起来有毛玻璃质感 -->
                    <Grid.Effect>
                        <BlurEffect Radius="15" RenderingBias="Quality" />
                    </Grid.Effect>
                </Grid>
                <!-- 前景内容层，为了防止前景也被模糊，单独放一个覆盖层显示文字和加载圈 -->
                <Grid x:Name="LoadingContent" Panel.ZIndex="1000" Visibility="Collapsed" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在初始化程序环境..." FontSize="18" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <hc:LoadingCircle IsRunning="True" DotSpeed="3" DotDiameter="8" Foreground="#FFB876DD" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Viewbox>
</Window>
