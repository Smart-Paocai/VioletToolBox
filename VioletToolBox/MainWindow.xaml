                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" TargetName="PART_Border" Value="#FF28A745"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
