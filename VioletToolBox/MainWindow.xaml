                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground"
                                                                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.Resources>
                                                    <DataGrid.CellStyle>
                                                        <StaticResource ResourceKey="EdlPartitionCellStyle"/>
                                                    </DataGrid.CellStyle>
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="{x:Type DataGridRow}">
                                                            <Setter Property="Background" Value="#FFFFFFFF"/>
                                                            <Setter Property="Foreground" Value="#FF334155"/>
                                                            <Setter Property="BorderBrush" Value="#FFF0F1F5"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="AlternationIndex" Value="1">
                                                                    <Setter Property="Background" Value="#FFFCFBFD"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFF6F1FF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#FF87CEEB"/>
                                                                    <Setter Property="Foreground" Value="#FF263142"/>
                                                                    <Setter Property="BorderBrush" Value="#FF6BBFE3"/>
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                    <Setter Property="Cursor" Value="No"/>
                                                                    <Setter Property="ToolTip" Value="该分区已受基带指纹保护，当前禁止写入"/>
                                                                    <Setter Property="ToolTipService.ShowDuration" Value="6000"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ElementName=EdlSkipDataCheckBox, Path=IsChecked}" Value="True"/>
                                                                        <Condition Binding="{Binding IsDataPartition}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#FFF2D7FF"/>
                                                                    <Setter Property="Foreground" Value="#FF475569"/>
                                                                    <Setter Property="BorderBrush" Value="#FFE2BFF3"/>
                                                                    <Setter Property="Cursor" Value="No"/>
                                                                    <Setter Property="ToolTip" Value="该数据分区已受保护，当前禁止写入"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Width="32">
