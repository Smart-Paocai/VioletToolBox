                                                        <CheckBox x:Name="MirrorTitleShowAndroidVersionCheckBox" Content="安卓版本" IsChecked="True" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowSerialCheckBox" Content="设备序列号" IsChecked="True" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowDeviceCodeCheckBox" Content="设备代号" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowBuildInfoCheckBox" Content="版本信息" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowUnlockStateCheckBox" Content="解锁状态" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowBatteryTempCheckBox" Content="电池温度" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowBatteryLevelCheckBox" Content="电量" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
                                                        <CheckBox x:Name="MirrorTitleShowStorageCheckBox" Content="存储空间" Margin="0,0,18,10" Checked="MirrorTitleOptionCheckBox_Changed" Unchecked="MirrorTitleOptionCheckBox_Changed"/>
