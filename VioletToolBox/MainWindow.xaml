                                                     MinHeight="0"
                                                     IsReadOnly="True"
                                                     IsDocumentEnabled="False"
                                                     Background="#FFFBFCFE"
                                                     Foreground="#FF1E293B"
                                                     BorderBrush="#FFDCE3EC"
                                                     BorderThickness="1"
                                                     Padding="10"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     TextChanged="FlashLogTextBox_TextChanged_2" />
                                            <ProgressBar x:Name="bootflash"
                                                     Grid.Row="1"
                                                     Margin="0,12,0,0"
                                                     Height="24"
                                                     Tag="0MB/s  |  Time:0s"
                                                     Background="#FFF0F0F0"
                                                     BorderBrush="#FFD8D8D8"
                                                     BorderThickness="1"
                                                     Value="0"
                                                     Maximum="100">
                                                <ProgressBar.Style>
                                                    <Style TargetType="{x:Type ProgressBar}">
                                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                                        <Grid ClipToBounds="True">
                                                                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                                                                <Border.Background>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Offset="0" Color="#FF87CEEB" />
                                                                                        <GradientStop Offset="1" Color="#FF4A90E2" />
                                                                                    </LinearGradientBrush>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                   HorizontalAlignment="Left"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="8,0,0,0"
                                                                                   FontSize="12"
                                                                                   Foreground="#FF333333"
                                                                                   FontWeight="Medium"/>
                                                                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,8,0"
                                                                                   FontSize="12"
                                                                                   Foreground="#FF333333"
                                                                                   FontWeight="Medium"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
