                                          Canvas.Top="5"
                                          Width="108"
                                          Height="32"
                                          Style="{StaticResource EdlComboBoxStyle}"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="EdlResetComboBox_SelectionChanged"
                                          IsEditable="True"
                                          IsReadOnly="True"
                                          SelectedIndex="-1"
                                          Text="EDL重启" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <ComboBoxItem Content="重启到系统"/>
                                        <ComboBoxItem Content="重启到EDL"/>
                                        <ComboBoxItem Content="重启到Recovery"/>
                                        <ComboBoxItem Content="重启到FastbootD"/>
                                    </ComboBox>
                                </Canvas>
                            </Viewbox>

                            <Grid
                                Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar
                                    x:Name="EdlProgressBar"
                                    Grid.Row="0"
                                    Height="24"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    Tag="0.00 B/s"
                                    Background="#FFF1F3F7"
                                    BorderBrush="#FFDCE1E8"
                                    BorderThickness="1"
                                    Margin="0">
                                    <ProgressBar.Style>
                                        <Style TargetType="{x:Type ProgressBar}">
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                        <Border
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                            <Grid ClipToBounds="True">
                                                                <Border
                                                                    x:Name="PART_Track"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" />
                                                                <Border
                                                                    x:Name="PART_Indicator"
                                                                    HorizontalAlignment="Left"
                                                                    CornerRadius="4">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource ProgressBarIndicatorWidthConverter}">
                                                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Offset="0" Color="#FF87CEEB" />
                                                                            <GradientStop Offset="1" Color="#FF4A90E2" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,0,0"
                                                                    FontSize="12"
                                                                    Foreground="#FF333333"
                                                                    FontWeight="Medium"
                                                                    IsHitTestVisible="False" />
                                                                <TextBlock
                                                                    Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.00}%}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0"
                                                                    FontSize="12"
                                                                    Foreground="#FF333333"
                                                                    FontWeight="Medium"
                                                                    IsHitTestVisible="False" />
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock
                                    x:Name="EdlProgressTextBlock"
                                    Grid.Row="1"
                                    Margin="8,6,8,0"
                                    FontSize="12"
                                    Foreground="#FF64748B"
                                    MaxWidth="520"
                                    TextTrimming="CharacterEllipsis"
                                    Text=""
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                            </Grid>

