                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#FFE9EDF2"/>
                                            <Setter Property="Foreground" Value="#FF98A2AF"/>
                                            <Setter Property="BorderBrush" Value="#FFD9DEE6"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </Style.Triggers>
