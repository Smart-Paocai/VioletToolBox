                                                 BorderThickness="1"
                                                 Background="#FFFFFFFF"
                                                 Foreground="#FF64748B"
                                                 Height="32"
                                                 TextChanged="FlashBatTextBox_TextChanged"
                                                 GotKeyboardFocus="FlashBatTextBox_GotKeyboardFocus"
                                                 FontWeight="Normal"/>
