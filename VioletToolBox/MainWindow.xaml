                                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#FFE6ECF3" BorderThickness="1" CornerRadius="14" Margin="0,8,0,0" Background="#FFFFFFFF" Padding="14" Height="231" VerticalAlignment="Top">
