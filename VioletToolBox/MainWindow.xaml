                                                    <Canvas Margin="0,0,0,10" Height="24">
                                                        <TextBlock Canvas.Left="0" Canvas.Top="0" FontSize="16" FontWeight="Bold" Foreground="#FF2F3A45" Width="169"><Run Text=" "/><Run Text="投屏"/><Run Language="zh-cn" Text="参数调节"/></TextBlock>
