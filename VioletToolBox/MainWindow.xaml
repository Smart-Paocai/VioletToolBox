                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding FilePath}"
                                                                               Margin="5,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding FileName}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding FileName}" Value="">
                                                                                            <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                            <Setter Property="Foreground" Value="#FF94A3B8"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding FileName}" Value="{x:Null}">
                                                                                            <Setter Property="Text" Value="双击选择文件路径"/>
                                                                                            <Setter Property="Foreground" Value="#FF94A3B8"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>

                                            <Border x:Name="EdlStopOperationOverlay"
                                                    Grid.RowSpan="2"
                                                    Panel.ZIndex="20"
                                                    Visibility="Collapsed"
                                                    Background="#B8FFFFFF"
                                                    BorderBrush="#66D8DEE8"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
