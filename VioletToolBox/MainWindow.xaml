                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF87CEEB"/>
                                            <Setter Property="Foreground" Value="#FF263142"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF2D7FF"/>
                                            <Setter Property="Foreground" Value="#FF475569"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF2D7FF"/>
                                            <Setter Property="Foreground" Value="#FF475569"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
