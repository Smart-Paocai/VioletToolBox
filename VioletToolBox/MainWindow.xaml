                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#FF334155"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
