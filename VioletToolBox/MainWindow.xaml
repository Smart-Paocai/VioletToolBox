                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource BasicFlashCardStyle}" Margin="0,0,0,-39">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <RichTextBox x:Name="FlashLogTextBox"
