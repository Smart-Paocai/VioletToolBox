                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ElementName=EdlSkipSafeCheckBox, Path=IsChecked}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsBasebandPartition}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </svg:SvgViewbox.Style>
                                                                        </svg:SvgViewbox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.HeaderStyle>
                                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="Background" Value="#FFF5F3F8"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.HeaderStyle>
                                                            <DataGridTemplateColumn.Header>
