                                            <!-- 投屏参数调节（跨两列） -->
                                            <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#FFE6ECF3" BorderThickness="1" CornerRadius="14" Background="#FFFFFFFF" Margin="2,12,0,0" Padding="14">
