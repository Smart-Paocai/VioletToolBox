  <ItemGroup>
    <Content Include="logo2.ico" />
    <None Update="Protos\update_metadata.proto">
      <GrpcServices>None</GrpcServices>
    </None>
    <None Update="QSaharaServer.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <!-- Official Release packages may provide these runtime tools separately. -->
    <Content Include="..\断点续传\aria2c.exe" Condition="Exists('..\断点续传\aria2c.exe')">
      <Link>exe\aria2c.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="exe\fix_usb3.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\avbtool\tools\pem\*.pem" Condition="Exists('..\avbtool\tools\pem')">
      <Link>avbtool\tools\pem\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="KernelPatch\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="LKM_Patch\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

